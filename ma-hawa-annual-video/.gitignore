node_modules
.venv
out/
*.log
__pycache__/
# Face photos are personal data and this repository is public:
# keep raw photos, processed heads and their metadata out of git.
assets/faces/raw/
assets/faces/*.png
assets/faces/*.jpg
assets/faces/faces.meta.json
# Music stays local too (licensing + size). The stand-in track is regenerated by `npm run placeholder`.
assets/audio/*
!assets/audio/.gitkeep

# Generated / recorded voice lines (regenerate with npm run voices)
assets/voice/raw/
assets/voice/*.wav

# The company logo stays local too (public repo).
assets/logo/*
!assets/logo/.gitkeep
